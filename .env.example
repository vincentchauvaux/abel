# Identifiant client OAuth « Application Web » (Google Identity Services)
# Créer ici : https://console.cloud.google.com/auth/clients
VITE_GOOGLE_CLIENT_ID=

# Origines autorisées à coller dans la console :
#   https://mimom.be
#   https://www.mimom.be
#   https://vincentchauvaux.github.io
#   http://localhost:5173
#
# Album : sur le VPS (chiffré). Google Drive reporté.
# server/.env : ALBUM_ENCRYPTION_KEY (64 hex) + ALBUM_DIR=/var/lib/abel/album

# API de sync (défaut = mimom.be)
# VITE_SYNC_URL=https://mimom.be/api

# Chemin de base Vite (GitHub Pages : /abel/ — mimom.be : /)
# VITE_BASE_PATH=/abel/
