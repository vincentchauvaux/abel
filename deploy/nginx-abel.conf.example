# Abel — snippet Nginx (HTTPS, hostname OVH)
# À inclure dans le server {} de vps-e09ed6db.vps.ovh.net
#
#   sudo cp deploy/nginx-abel.conf.example /etc/nginx/snippets/abel.conf
#   include snippets/abel.conf;
#   sudo nginx -t && sudo systemctl reload nginx

location = /abel/api {
    return 301 $scheme://$host/abel/api/;
}

location /abel/api/ {
    proxy_pass http://127.0.0.1:3030/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_read_timeout 60s;
    client_max_body_size 2m;
}
