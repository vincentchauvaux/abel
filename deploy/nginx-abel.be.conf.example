# Abel — site + API sur abel.be (HTTPS via Certbot)
#   cp deploy/nginx-abel.be.conf.example /etc/nginx/sites-available/abel.be
#   ln -sf /etc/nginx/sites-available/abel.be /etc/nginx/sites-enabled/abel.be
#   certbot --nginx -d abel.be -d www.abel.be

server {
    listen 80;
    listen [::]:80;
    server_name abel.be www.abel.be;

    root /var/www/abel;
    index index.html;

    location /.well-known/acme-challenge/ {
        allow all;
    }

    location = /api {
        return 301 $scheme://$host/api/;
    }

    location /api/ {
        limit_req zone=abel_api burst=20 nodelay;

        proxy_pass http://127.0.0.1:3030/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_read_timeout 60s;
        client_max_body_size 2m;

        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
